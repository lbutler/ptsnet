{
  "name": "ptsnet",
  "version": "0.2.0",
  "description": "Transient simulation in water networks (Method of Characteristics) — TypeScript port of PTSNET",
  "type": "module",
  "main": "./dist/ptsnet.cjs",
  "module": "./dist/ptsnet.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ptsnet.js",
      "require": "./dist/ptsnet.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "water",
    "hammer",
    "transient",
    "hydraulics",
    "epanet",
    "moc",
    "simulation"
  ],
  "license": "Unlicense",
  "dependencies": {
    "epanet-js": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
